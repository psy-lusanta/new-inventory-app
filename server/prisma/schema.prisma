// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  admin
  staff
  viewer
}

enum FieldType {
  text
  number
  date
  boolean
  dropdown
}

enum MovementType {
  restock
  deduction
  adjustment
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  password           String
  role               Role     @default(viewer)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())

  // Relations
  inventoryTables InventoryTable[]
  inventoryRows   InventoryRow[]
  stockMovements  StockMovement[]
  pafForms    PafForm[]
  activityLogs ActivityLog[]
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  notifications Notification[]
}

model InventoryTable {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  // Relations
  createdBy   String
  user        User              @relation(fields: [createdBy], references: [id])
  fields      FieldDefinition[]
  rows        InventoryRow[]
  movements   StockMovement[]

  @@index([createdAt])
  @@index([createdBy])
}

model FieldDefinition {
  id                String    @id @default(uuid())
  fieldName         String
  fieldType         FieldType
  required          Boolean   @default(false)
  isUnique          Boolean   @default(false)
  isStockField      Boolean   @default(false)
  lowStockThreshold Float?
  order             Int       @default(0)
  options           Json?     // [{ label: "Deployed", color: "#10b981" }]

  tableId           String
  table             InventoryTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, fieldName])
}

model InventoryRow {
  id        String   @id @default(uuid())
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String? 

  tableId   String
  table     InventoryTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  createdBy String
  user      User            @relation(fields: [createdBy], references: [id])
  movements StockMovement[]

  @@index([tableId])
  @@index([tableId, createdAt])
  @@index([createdBy])
  @@index([updatedAt])
}

model StockMovement {
  id        String       @id @default(uuid())
  fieldName String
  type      MovementType
  delta     Float
  note      String?
  createdAt DateTime     @default(now())

  // Relations
  tableId   String
  table     InventoryTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  rowId     String
  row       InventoryRow   @relation(fields: [rowId], references: [id], onDelete: Cascade)
  createdBy String
  user      User           @relation(fields: [createdBy], references: [id])

  @@index([tableId])
  @@index([rowId])
  @@index([createdAt])
  @@index([createdBy])
}

// ─── Accountability ───────────────────────────────────────────────────────────────────
model PafForm {
  id           String   @id @default(uuid())
  pafNo        String   @unique
  employeeName String
  contactNo    String?
  address      String?
  date         String
  position     String?
  deptBranch   String?
  status       String   @default("draft")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy    String
  user         User      @relation(fields: [createdBy], references: [id])
  items        PafItem[]

  @@index([createdAt])
  @@index([createdBy])
  @@index([pafNo])
}

model PafItem {
  id           String  @id @default(uuid())
  particulars  String?
  assetTag     String?
  brand        String?
  modelPartNo  String?
  serialImeiNo String?
  order        Int     @default(0)

  formId       String
  form         PafForm @relation(fields: [formId], references: [id], onDelete: Cascade)
}

model PafCounter {
  id      String @id @default(uuid())
  dept    String
  year    String
  counter Int    @default(0)

  @@unique([dept, year])
}

model ActivityLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  entityName String?
  tableName  String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade) // ← add onDelete: Cascade

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@index([entityType])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade) // ← add onDelete: Cascade

  @@index([userId, isRead])
  @@index([createdAt])
}
